#version 460

// NRD lane, stage 2: remodulate ReLAX's output into PreFinal.
//
// This is CmNoisyCompose's composition arithmetic VERBATIM -- the same
// ro_d / ro_s / guideMod factors applied to the same signals -- except the
// lighting is NRD-denoised instead of raw. Everything downstream (checkerboard
// resolve, raster, CmPrepareFinal with exposure BAKED IN, DLSS-SR upscale) is
// the untouched A-SVGF frame shape: no RR machinery, no pre-exposure reorder,
// no post-RR glow add. That frame shape is the one the user reports as stable.
//
// Validation debug: with nrdValidation set, NRD's own OUT_VALIDATION overlay
// (guide sanity, reprojection, history length) replaces the image -- the
// vendor-supplied answer to "did any of this reach the GPU correctly".

#define DESC_SET_FRAMEBUFFERS 0
#define DESC_SET_GLOBAL_UNIFORM 1
#include "ShaderCommonGLSLFunc.h"
#include "BRDF.h"

layout(local_size_x = COMPUTE_COMPOSE_GROUP_SIZE_X, local_size_y = COMPUTE_COMPOSE_GROUP_SIZE_Y, local_size_z = 1) in;

void main()
{
    const ivec2 pix = ivec2( gl_GlobalInvocationID.x, gl_GlobalInvocationID.y );
    if( pix.x >= int( globalUniform.renderWidth ) || pix.y >= int( globalUniform.renderHeight ) )
    {
        return;
    }
    const ivec2 checkerboardPix = getCheckerboardPix( pix );

    const vec3 albedo     = texelFetch( framebufAlbedo_Sampler, pix, 0 ).rgb;
    const vec3 throughput = texelFetch( framebufThroughput_Sampler, checkerboardPix, 0 ).rgb;

    vec3 illuminated;

    if( !isSkyPix( checkerboardPix ) )
    {
        const vec2  mrFb     = texelFetch( framebufMetallicRoughness_Sampler, checkerboardPix, 0 ).xy;
        const float metallic = mrFb.x;

        const vec3 diffDenoised = texelFetch( framebufNrdDiffuseOut_Sampler, pix, 0 ).rgb;
        const vec3 specDenoised = texelFetch( framebufNrdSpecularOut_Sampler, pix, 0 ).rgb;

        const vec3 ro_s = getSpecularColor( albedo, metallic );
        const vec3 ro_d = albedo * ( 1.0 - metallic );

        const vec3 guideMod = throughput * getMaterialAmbient( albedo );

        // CmNoisyCompose: ((diffuse + indirect) * ro_d + specular * ro_s) *
        // guideMod -- diffuse+indirect were summed at PACK time, the fake-rough
        // specular mix too, so this is the identical composition.
        illuminated = ( diffDenoised * ro_d + specDenoised * ro_s ) * guideMod;
    }
    else
    {
        // sky: smooth HDR radiance, never denoised (out of denoisingRange)
        illuminated = albedo * throughput;
    }

    if( globalUniform.nrdValidation != 0 )
    {
        const vec3 v = texelFetch( framebufNrdValidation_Sampler, pix, 0 ).rgb;
        illuminated  = v * 4.0; // roughly display-bright under the later exposure
    }

    imageStore( framebufPreFinal, pix, vec4( max( vec3( 0.0 ), illuminated ), 0.0 ) );
}
