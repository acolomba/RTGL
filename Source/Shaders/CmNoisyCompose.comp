#version 460

// Noisy lighting compose for DLSS Ray Reconstruction (skips A-SVGF).
// Writes PreFinal + RR G-buffer staging into unused SVGF ping/pong buffers.
//
// ALWAYS reads raw unfiltered ReSTIR. The A-SVGF-temporal-into-RR path was
// removed: it ghosted, and reading DiffTemporary without AccumulateForRR
// produced an all-black world (only raster sprites visible).

#define DESC_SET_FRAMEBUFFERS 0
#define DESC_SET_GLOBAL_UNIFORM 1
#include "ShaderCommonGLSLFunc.h"
#include "BRDF.h"

layout(local_size_x = COMPUTE_COMPOSE_GROUP_SIZE_X, local_size_y = COMPUTE_COMPOSE_GROUP_SIZE_Y, local_size_z = 1) in;

void main()
{
    const ivec2 pix             = ivec2( gl_GlobalInvocationID.x, gl_GlobalInvocationID.y );
    const ivec2 checkerboardPix = getCheckerboardPix( pix );

    if( pix.x >= int( globalUniform.renderWidth ) || pix.y >= int( globalUniform.renderHeight ) )
    {
        return;
    }

    const vec3 diffuse  = texelFetchUnfilteredDirect( checkerboardPix );
    const vec3 indirect = texelFetchUnfilteredIndir( checkerboardPix );
    const vec3 specRaw  = texelFetchUnfilteredSpecular( checkerboardPix );

    const vec3 albedo     = texelFetch( framebufAlbedo_Sampler, pix, 0 ).rgb;
    const vec3 throughput = texelFetch( framebufThroughput_Sampler, checkerboardPix, 0 ).rgb;

    vec3 illuminated;
    vec3 normal     = vec3( 0.0, 0.0, 1.0 );
    float roughness = 1.0;
    vec3  specAlb   = vec3( 0.0 );

    if( !isSkyPix( checkerboardPix ) )
    {
        const vec2 mrFb      = texelFetch( framebufMetallicRoughness_Sampler, checkerboardPix, 0 ).xy;
        const float metallic = mrFb.x;
        roughness            = mrFb.y;
        normal               = texelFetchNormal( checkerboardPix );

        const vec3 specular = mix(
            specRaw,
            indirect,
            smoothstep( FAKE_ROUGH_SPECULAR_THRESHOLD,
                        FAKE_ROUGH_SPECULAR_THRESHOLD + FAKE_ROUGH_SPECULAR_LENGTH,
                        roughness ) );

        const vec3 ro_s = getSpecularColor( albedo, metallic );
        const vec3 ro_d = albedo * ( 1.0 - metallic );
        specAlb         = ro_s;

        illuminated = ( diffuse + indirect ) * ro_d + specular * ro_s;
        illuminated *= throughput;
        illuminated *= getMaterialAmbient( albedo );
    }
    else
    {
        illuminated = albedo * throughput;
        normal      = vec3( 0.0, 0.0, 1.0 );
        roughness   = 1.0;
        specAlb     = vec3( 0.0 );
    }

    imageStore( framebufPreFinal, pix, vec4( max( vec3( 0.0 ), illuminated ), 0.0 ) );

    // RR staging (reused SVGF buffers; safe while A-SVGF is skipped):
    imageStore( framebufDiffPingColorAndVariance, pix, vec4( normal, roughness ) );
    imageStore( framebufDiffPongColorAndVariance, pix, vec4( specAlb, 0.0 ) );
}
