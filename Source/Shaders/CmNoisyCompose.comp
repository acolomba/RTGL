#version 460

// Noisy lighting compose for DLSS Ray Reconstruction (skips A-SVGF).
// Writes PreFinal + RR G-buffer staging into unused SVGF ping/pong buffers.
//
// ALWAYS reads raw unfiltered ReSTIR. The A-SVGF-temporal-into-RR path was
// removed: it ghosted, and reading DiffTemporary without AccumulateForRR
// produced an all-black world (only raster sprites visible).
//
// RR guides (RR Integration Guide 3.4):
//   diffuse albedo  = ro_d * throughput * ambient   -> DiffColorHistory
//   specular albedo = envBRDFApprox2(F0, r^2, NoV)
//                     * throughput * ambient        -> DiffPongColorAndVariance
//   normals+roughness (packed)                      -> DiffPingColorAndVariance
// Every factor that multiplies the color must be in the guides, otherwise it
// survives RR's internal demodulation as pseudo-noise.
//
// Disocclusion mask (RR Integration Guide optional inputs; Remix sentinel):
// RR has no anti-firefly / history-reset of its own, so transient lights
// (barrel explosions, muzzle flashes, occluded glows) linger for seconds.
// Compare the motion-reprojected per-tile mean of the *lighting-only*
// luminance (view- and albedo-independent) against the previous frame; on a
// sharp change, write 10000.0 to force RR to drop history for the tile.
// Per-pixel compares are useless at 1 spp: tile means (16x16 = 256 taps)
// have ~1/16 the relative noise, so a ratio threshold of 2..4 is stable.

#define DESC_SET_FRAMEBUFFERS 0
#define DESC_SET_GLOBAL_UNIFORM 1
#include "ShaderCommonGLSLFunc.h"
#include "BRDF.h"

layout(local_size_x = COMPUTE_COMPOSE_GROUP_SIZE_X, local_size_y = COMPUTE_COMPOSE_GROUP_SIZE_Y, local_size_z = 1) in;

#define DISOCC_TILE_THREADS ( COMPUTE_COMPOSE_GROUP_SIZE_X * COMPUTE_COMPOSE_GROUP_SIZE_Y )
#define DISOCC_FORCE_HISTORY_DISCARD 10000.0

// x = current lum, y = 1 if pixel is on screen,
// z = reprojected previous lum, w = 1 if reprojection was valid
shared vec4 s_lum[ DISOCC_TILE_THREADS ];

// Firefly clamp for the DLSS-RR path.
//
// RTGL feeds RR raw 1-spp radiance: ComposeNoisy applies no spatial filter, and
// AccumulateForRR (the temporal prefilter) is never called. A-SVGF by contrast
// runs anti-firefly plus a variance-driven atrous, which is most of why it looks
// stabler in motion -- once camera movement costs RR its temporal history, what
// is left underneath is the unfiltered signal. Remix runs an equivalent clamp
// before RR for the same reason.
//
// Deliberately conservative: a pixel is scaled down only if it out-shines the
// BRIGHTEST of its 4 spatial neighbours by rrFireflyThreshold. A genuinely
// bright region has bright neighbours and is untouched; only isolated
// single-sample spikes are. Chroma is preserved (uniform scale), so this
// suppresses outliers without the blur a real spatial filter would cost -- which
// matters because NVIDIA's guidance is to feed RR high-quality noisy input, not
// pre-mangled input.
vec3 suppressFirefly( const vec3 c, const vec3 n0, const vec3 n1, const vec3 n2, const vec3 n3 )
{
    const float thr = globalUniform.rrFireflyThreshold;
    if( thr <= 0.0 )
    {
        return c;
    }

    const float lumC = getLuminance( c );
    const float floorLum = globalUniform.rrFireflyMinLum;

    // near-black: ratios are meaningless, and clamping here only eats detail
    if( lumC <= floorLum )
    {
        return c;
    }

    const float lumN = max( max( getLuminance( n0 ), getLuminance( n1 ) ),
                            max( getLuminance( n2 ), getLuminance( n3 ) ) );

    const float limit = thr * max( lumN, floorLum );

    return lumC > limit ? c * ( limit / lumC ) : c;
}

// Spatial neighbour in REGULAR pixel space, mapped back to checkerboard space.
// Stepping directly in checkerboard coords would not give a spatial neighbour:
// the two checkerboard halves interleave into alternating columns.
ivec2 neighbourCheckerboardPix( const ivec2 regularPix, const ivec2 offset )
{
    const ivec2 p = clamp( regularPix + offset,
                           ivec2( 0 ),
                           ivec2( int( globalUniform.renderWidth ) - 1,
                                  int( globalUniform.renderHeight ) - 1 ) );
    return getCheckerboardPix( p );
}

void main()
{
    const ivec2 pix             = ivec2( gl_GlobalInvocationID.x, gl_GlobalInvocationID.y );
    const ivec2 checkerboardPix = getCheckerboardPix( pix );

    // no early-out: every invocation must reach the barriers below;
    // out-of-screen threads contribute zero weight to the tile stats
    const bool inScreen = pix.x < int( globalUniform.renderWidth ) &&
                          pix.y < int( globalUniform.renderHeight );

    vec3 illuminated = vec3( 0.0 );
    // lighting-only signal for the disocclusion mask: irradiance without
    // albedo (cancels materials) and without specular (view-dependent)
    float signalLum  = 0.0;

    if( inScreen )
    {
        vec3 diffuse  = texelFetchUnfilteredDirect( checkerboardPix );
        vec3 indirect = texelFetchUnfilteredIndir( checkerboardPix );
        vec3 specRaw  = texelFetchUnfilteredSpecular( checkerboardPix );

        // Off by default -- keep the 12 neighbour fetches out of the common path.
        if( globalUniform.rrFireflyThreshold > 0.0 )
        {
            const ivec2 nbL = neighbourCheckerboardPix( pix, ivec2( -1, 0 ) );
            const ivec2 nbR = neighbourCheckerboardPix( pix, ivec2( 1, 0 ) );
            const ivec2 nbU = neighbourCheckerboardPix( pix, ivec2( 0, -1 ) );
            const ivec2 nbD = neighbourCheckerboardPix( pix, ivec2( 0, 1 ) );

            // Clamp each signal independently: a firefly in direct lighting should
            // not be masked by a bright neighbour in indirect, and vice versa.
            diffuse  = suppressFirefly( diffuse,
                                        texelFetchUnfilteredDirect( nbL ),
                                        texelFetchUnfilteredDirect( nbR ),
                                        texelFetchUnfilteredDirect( nbU ),
                                        texelFetchUnfilteredDirect( nbD ) );
            indirect = suppressFirefly( indirect,
                                        texelFetchUnfilteredIndir( nbL ),
                                        texelFetchUnfilteredIndir( nbR ),
                                        texelFetchUnfilteredIndir( nbU ),
                                        texelFetchUnfilteredIndir( nbD ) );
            specRaw  = suppressFirefly( specRaw,
                                        texelFetchUnfilteredSpecular( nbL ),
                                        texelFetchUnfilteredSpecular( nbR ),
                                        texelFetchUnfilteredSpecular( nbU ),
                                        texelFetchUnfilteredSpecular( nbD ) );
        }

        const vec3 albedo     = texelFetch( framebufAlbedo_Sampler, pix, 0 ).rgb;
        const vec3 throughput = texelFetch( framebufThroughput_Sampler, checkerboardPix, 0 ).rgb;

        vec3  normal    = vec3( 0.0, 0.0, 1.0 );
        float roughness = 1.0;
        vec3  guideDiff = vec3( 0.5 );
        vec3  guideSpec = vec3( 0.5 );

        if( !isSkyPix( checkerboardPix ) )
        {
            const vec2 mrFb      = texelFetch( framebufMetallicRoughness_Sampler, checkerboardPix, 0 ).xy;
            const float metallic = mrFb.x;
            roughness            = mrFb.y;
            normal               = texelFetchNormal( checkerboardPix );

            const vec3 specular = mix(
                specRaw,
                indirect,
                smoothstep( FAKE_ROUGH_SPECULAR_THRESHOLD,
                            FAKE_ROUGH_SPECULAR_THRESHOLD + FAKE_ROUGH_SPECULAR_LENGTH,
                            roughness ) );

            const vec3 ro_s = getSpecularColor( albedo, metallic );
            const vec3 ro_d = albedo * ( 1.0 - metallic );

            // every factor multiplying the color must be in the guides too
            const vec3 guideMod = throughput * getMaterialAmbient( albedo );

            illuminated = ( ( diffuse + indirect ) * ro_d + specular * ro_s ) * guideMod;

            const vec3 viewDir = texelFetch( framebufViewDirection_Sampler, checkerboardPix, 0 ).xyz;
            const float NoV    = dot( normal, -viewDir );

            // Floor the guides away from zero. RR demodulates the colour by
            // these (lighting ~ colour / guide) and remodulates with the same
            // values, so a small floor is essentially free -- but WITHOUT it the
            // division explodes wherever ro_d * guideMod approaches 0: dark
            // albedo, low throughput, and exactly 0 on metallic surfaces. That
            // is what produces correlated dark worms in dim distant rooms while
            // brightly lit near walls stay clean, and why A-SVGF (which never
            // reads these guides) shows none of it.
            //
            // The sky branch below has always floored its guides for precisely
            // this reason, citing RR guide 3.4.2; the world branch never did.
            const vec3 guideFloor = vec3( globalUniform.rrGuideMin );

            // See rrGuideMode in GenerateShaderCommon.py. Mode 1 is what the
            // 2026-08-06 guide rework introduced; mode 0 restores the raw
            // material guides that predate it. `illuminated` above is NOT
            // touched by this -- only what RR is told the albedo is.
            switch( globalUniform.rrGuideMode )
            {
                case 0:
                    guideDiff = max( albedo, guideFloor );
                    guideSpec = max( ro_s, guideFloor );
                    break;
                case 2:
                    guideDiff = max( ro_d, guideFloor );
                    guideSpec = max( envBRDFApprox2( ro_s, roughness * roughness, NoV ),
                                     guideFloor );
                    break;
                default:
                    guideDiff = max( ro_d * guideMod, guideFloor );
                    guideSpec = max( envBRDFApprox2( ro_s, roughness * roughness, NoV ) * guideMod,
                                     guideFloor );
                    break;
            }

            signalLum = getLuminance( diffuse + indirect );
        }
        else
        {
            // sky: color is smooth HDR radiance; guides just need to be
            // bounded and non-zero (RR guide 3.4.2 - do not leave uncleared)
            illuminated = albedo * throughput;
            signalLum   = getLuminance( illuminated );
        }

        // DLSS-RR pInSpecularHitDistance: world distance from this shading point
        // to whatever produced the highlight. framebufViewDirection.w already
        // carries it (distToLight, written by RtRaygenDirect); this just resolves
        // it from checkerboard into regular pixel space, like the guides above.
        // Sky has no specular event -> 0.
        {
            const float rawDist =
                texelFetch( framebufViewDirection_Sampler, checkerboardPix, 0 ).w;

            // MAX_RAY_LENGTH is processDirectIllumination's "no light found"
            // sentinel, so EVERY shadowed or unlit pixel carries 10000.0 here.
            // Handing that to NGX says "this pixel's reflection is 10km away"
            // and wrecks RR's specular reprojection exactly in the dark pixels
            // -- a black grain over the whole image. 0 is the correct value for
            // "no specular event"; a wrong guide really is worse than none.
            const bool noSpecularEvent = isSkyPix( checkerboardPix ) ||
                                         !( rawDist > 0.0 ) ||           // also catches NaN
                                         rawDist >= MAX_RAY_LENGTH * 0.5;

            imageStore( framebufSpecularHitDistance,
                        pix,
                        vec4( noSpecularEvent ? 0.0 : rawDist ) );
        }

        imageStore( framebufPreFinal, pix, vec4( max( vec3( 0.0 ), illuminated ), 0.0 ) );

        // RR staging (reused SVGF buffers; safe while A-SVGF is skipped):
        imageStore( framebufDiffPingColorAndVariance, pix, vec4( normal, roughness ) );
        imageStore( framebufDiffPongColorAndVariance, pix, vec4( guideSpec, 0.0 ) );
        imageStore( framebufDiffColorHistory,         pix, vec4( guideDiff, 0.0 ) );
    }

    // -- disocclusion mask -------------------------------------------------

    float prevLum   = 0.0;
    bool  prevValid = false;

    if( inScreen && globalUniform.rrDisoccEnable != 0 )
    {
        const vec2 renderSize = vec2( globalUniform.renderWidth, globalUniform.renderHeight );
        // MotionDlss: regular-space UV delta, prevUV = curUV + mv
        const vec2 mv     = texelFetch( framebufMotionDlss_Sampler, pix, 0 ).rg;
        const vec2 prevUV = ( vec2( pix ) + 0.5 ) / renderSize + mv;

        const ivec2 prevPix = ivec2( prevUV * renderSize );

        if( all( greaterThanEqual( prevPix, ivec2( 0 ) ) ) &&
            all( lessThan( prevPix, ivec2( renderSize ) ) ) )
        {
            prevLum   = texelFetch( framebufRrLumHistory_Prev_Sampler, prevPix, 0 ).r;
            prevValid = true;
        }
    }

    s_lum[ gl_LocalInvocationIndex ] = vec4( inScreen ? signalLum : 0.0,
                                             inScreen ? 1.0 : 0.0,
                                             prevValid ? prevLum : 0.0,
                                             prevValid ? 1.0 : 0.0 );
    barrier();

    for( uint s = DISOCC_TILE_THREADS / 2; s > 0; s /= 2 )
    {
        if( gl_LocalInvocationIndex < s )
        {
            s_lum[ gl_LocalInvocationIndex ] += s_lum[ gl_LocalInvocationIndex + s ];
        }
        barrier();
    }

    if( inScreen )
    {
        float mask = 0.0;

        if( globalUniform.rrDisoccEnable != 0 )
        {
            const vec4 t = s_lum[ 0 ];

            // require most of the tile to reproject on-screen; new screen
            // regions are handled by RR itself via depth + motion vectors
            if( t.y > 0.5 && t.w > 0.5 * t.y )
            {
                const float meanCur  = t.x / t.y;
                const float meanPrev = t.z / t.w;

                const float hi = max( meanCur, meanPrev );
                const float lo = min( meanCur, meanPrev );

                if( hi > lo * max( globalUniform.rrDisoccRatio, 1.0 ) &&
                    hi - lo > globalUniform.rrDisoccMinDelta )
                {
                    mask = DISOCC_FORCE_HISTORY_DISCARD;
                }
            }
        }

        imageStore( framebufRrDisocclusion, pix, vec4( mask ) );
        imageStore( framebufRrLumHistory, pix, vec4( signalLum ) );
    }
}
