#version 460

// Doom64-RT: EXPOSURE AND SCREEN EMISSIVE, APPLIED AFTER DLSS-RR.
//
// WHY THIS PASS EXISTS. DLSS Ray Reconstruction wants linear PRE-exposure
// radiance: its integration guide (S3.7) declares exposure, auto-exposure and
// sharpening unsupported, and tells you to ignore the SR guide's exposure
// sections outright. Before this pass, CmPrepareFinal multiplied EV100 auto
// exposure into FINAL -- the exact image RR consumes -- while DLSSRR.cpp told
// NGX `InPreExposure = 1.0`. So whenever adaptation moved (and Doom's dark
// interiors move it constantly, EV100 2.0..7.7 is a ~52x swing), RR's temporal
// history held frames captured at a DIFFERENT exposure than the current one,
// with no way to know. A-SVGF never had this problem: it accumulates in linear
// radiance BEFORE exposure. That asymmetry is the one structural difference
// RAYRECONSTRUCTION.md blamed -- and the fix its plan deferred.
//
// So: with rrPreExposure set, CmPrepareFinal skips its EV100 multiply and its
// screen-emissive add, RR reconstructs genuinely pre-exposure radiance (its
// InPreExposure = 1.0 becomes truthful), and both operations happen here, on
// the UPSCALED output, in the same order they had at render resolution.
//
// THE ALGEBRA IS PRESERVED the same way CmVolumeCompose.comp:44-49 proves its
// own reorder. Under RR the medium was already composited at render res
// (volumePostComp is forced 0, so CmPrepareFinal ran `hdr = hdr*T + S`), so:
//
//     before:  out = RR( (surf*T + S)*exp + emis*emisMax*T )
//     after:   RRin = surf*T + S                          (CmPrepareFinal)
//              out  = RR(RRin)*exp + emis*emisMax*T       (here)
//
// -- identical per pixel up to RR itself, which is the point: the only thing
// that changed is WHAT RR denoises.
//
// A side benefit: the emissive glow is now added at output resolution from the
// render-res buffer (bilinear), so RR no longer "denoises" the unguided glow --
// rr-noise-fix-proposals.md item 6 flagged exactly that as a churn source.

#define DESC_SET_FRAMEBUFFERS 0
#define DESC_SET_GLOBAL_UNIFORM 1
#define DESC_SET_TONEMAPPING 2
#include "ShaderCommonGLSLFunc.h"
#include "Exposure.h"

layout( local_size_x = 16, local_size_y = 16, local_size_z = 1 ) in;

layout( push_constant ) uniform RrPostExposurePush_BT
{
    uint width;
    uint height;
    uint pad0;
    uint pad1;
}
push;

void main()
{
    const ivec2 pix = ivec2( gl_GlobalInvocationID.xy );

    if( pix.x >= int( push.width ) || pix.y >= int( push.height ) )
    {
        return;
    }

    // Belt and braces: the C++ call site is gated on the same uniform, so this
    // never fires -- but a pass that applies exposure must not be able to
    // disagree with the pass that skipped it. Single source of truth.
    if( globalUniform.rrPreExposure == 0 )
    {
        return;
    }

    // Debug views replace the image wholesale in CmPrepareFinal (processDebug
    // runs AFTER the gated blocks and overwrites hdr with raw buffer contents).
    // Exposing those here would only rescale a diagnostic; keep them
    // bit-identical to what the non-reordered path shows.
    if( globalUniform.debugShowFlags != 0 )
    {
        return;
    }

    // Same for the volumetric bias-mask view, which CmPrepareFinal writes at the
    // very END of main() -- outside the blocks this reorder gates, and NOT part
    // of debugShowFlags, so the check above does not cover it. Without this the
    // mask would be the one thing in the frame this pass scales by exposure.
    if( globalUniform.volumeUpscaleBiasDebug != 0 )
    {
        return;
    }

    // IN PLACE on RR's fixed output image (DLSSRR.cpp OUTPUT_IMAGE). Every
    // invocation reads and writes exactly its own pixel -- no hazard, no
    // ping-pong needed, same argument as CmVolumeCompose.comp:113-117.
    vec3 c = imageLoad( framebufUpscaledPong, pix ).rgb;

    // Auto exposure -- the exact multiply CmPrepareFinal skipped. Same
    // tonemapping buffer, same frame, same value: CalculateExposure ran before
    // CmPrepareFinal and reads PRE_FINAL, which this reorder never touches.
    //
    // NOT guarded by classicShading: at render res the guard exempted
    // classic-shaded pixels, but DrawClassic repaints that region on top of
    // this pass's output (VulkanDevice.cpp, ordering comment at the
    // volumePostComp block), so exposing it here is overwritten anyway.
    c *= ev100ToLuminousExposure( getCurrentEV100() );

    // Screen emissive at output resolution. Both source buffers are REGULAR
    // pixel space at render res; sampled by normalised coordinate so this works
    // at any upscale ratio. No jitter correction: CmVolumeCompose.comp:147-155
    // measured both signs for the veil and neither mattered; the glow is
    // smooth, and half a render texel is below its feature size. Revisit only
    // if emissive panel edges shimmer under RR.
    const vec2 uv = ( vec2( pix ) + 0.5 ) / vec2( push.width, push.height );

    // BILINEAR -- the reason ScreenEmission now carries
    // FRAMEBUF_FLAGS_BILINEAR_SAMPLER.
    vec3 screenEmis = textureLod( framebufScreenEmission_Sampler, uv, 0.0 ).rgb;

    // Attenuated by the medium, as in CmPrepareFinal -- an emissive panel must
    // not shine through smoke at full strength. volumePostComp is always 0 on
    // the RR path (postCompOk forces it), so unlike CmPrepareFinal there is no
    // "the post pass owns the attenuation" case; the guard is kept anyway so
    // the two shaders can never disagree about who applies T.
    //
    // ONE KNOWN DIVERGENCE, deliberate: CmPrepareFinal attenuates by the
    // possibly-FEATHERED transmittance (its volumeEdgeSoft 3x3 silhouette
    // average), this samples raw Scattering.a. It applies only to the emissive
    // attenuation term, only at silhouettes, and bilinear sampling already
    // averages across the same texels -- reproducing the feather here would
    // mean re-running a 3x3 at reconstructed render pixels for a fraction of a
    // fraction. Revisit only if emissive edges seen through fog read wrong.
    if( globalUniform.volumeOccludeEmis != 0 && globalUniform.volumePostComp == 0 )
    {
        vec4 v = textureLod( framebufScattering_Sampler, uv, 0.0 );

        // NO FOG ON THE GUN -- the same override CmPrepareFinal and
        // CmVolumeCompose both apply: the scattering buffer under a
        // first-person pixel holds the WORLD's fog on purpose.
        if( globalUniform.volumeFp > 0.5 )
        {
            const ivec2 rpix = ivec2( uv * vec2( globalUniform.renderWidth,
                                                 globalUniform.renderHeight ) );
            const uint  ci   = floatBitsToUint(
                texelFetch( framebufSurfacePosition_Sampler,
                            getCheckerboardPix( clamp( rpix,
                                                       ivec2( 0 ),
                                                       ivec2( int( globalUniform.renderWidth ) - 1,
                                                              int( globalUniform.renderHeight ) - 1 ) ) ),
                            0 )
                    .a );
            if( ( ci & INSTANCE_CUSTOM_INDEX_FLAG_FIRST_PERSON ) != 0 )
            {
                v = vec4( 0, 0, 0, 1 );
            }
        }

        screenEmis *= v.a;
    }

    c += screenEmis * globalUniform.emissionMaxScreenColor;

    // DLSS-RR disocclusion mask A/B view, relocated from CmPrepareFinal: there
    // it would now land pre-exposure and be scaled into invisibility.
    if( globalUniform.rrDisoccShowMask != 0 )
    {
        if( textureLod( framebufRrDisocclusion_Sampler, uv, 0.0 ).r > 0.0 )
        {
            c = mix( c, vec3( 4.0, 0.0, 0.0 ), 0.5 );
        }
    }

    // THE ABSURD ARM. A subtle A/B cannot distinguish "no visible difference"
    // from "the pass never ran" -- this can. Magenta means live.
    if( globalUniform.rrPreExpDebug != 0 )
    {
        c = mix( c, vec3( 4.0, 0.0, 4.0 ), 0.5 );
    }

    imageStore( framebufUpscaledPong, pix, vec4( c, 0 ) );
}
