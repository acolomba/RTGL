#version 460

// don't need albedo for direct illumination
#define MATERIAL_MAX_ALBEDO_LAYERS 0
#define MATERIAL_LIGHTMAP_LAYER_INDEX -1

#define DESC_SET_TLAS 0
#define DESC_SET_FRAMEBUFFERS 1
#define DESC_SET_GLOBAL_UNIFORM 2
#define DESC_SET_VERTEX_DATA 3
#define DESC_SET_TEXTURES 4
#define DESC_SET_RANDOM 5
#define DESC_SET_LIGHT_SOURCES 6
#define LIGHT_SAMPLE_METHOD (LIGHT_SAMPLE_METHOD_DIRECT)
#include "RaygenCommon.h"


// ---------------------------------------------------------------------------
// Doom64-RT: caustics projected from water onto the geometry around it.
//
// A 1-spp path tracer cannot find these. A caustic is a specular-to-diffuse
// path -- light refracted/reflected by the wavy surface and focused onto a
// wall -- and the chance of a random diffuse bounce landing on the water AND
// scattering into a light is effectively zero, so the effect simply never
// appears no matter how good the denoiser is.
//
// So project them instead. Each shading point fires ONE probe ray straight
// down; if it lands on a surface RTGL considers water within waterCausticDist,
// the point is "over water" and its lighting gets modulated by an animated
// caustic field. The field is sampled from the same water normal texture the
// surface waves use, so the two agree.
//
// The modulation is MULTIPLICATIVE on direct lighting, never additive: caustics
// are focused light, not a light source. A pitch-black room must stay black --
// an additive term would make water glow in the dark and wash the GI, exactly
// the failure documented for world emissives in compat-patches.md.
// ---------------------------------------------------------------------------

// Is there water directly below this point? Probe ray, offset along the normal
// so a point ON a wall probes the floor in FRONT of the wall rather than
// grazing the wall's own base.
bool isOverWater( const vec3 position, const vec3 normal )
{
    const vec3 up     = globalUniform.worldUpVector.xyz;
    const vec3 origin = position + normal * 0.05;

    resetPayload();

    traceRayEXT( topLevelAS,
                 gl_RayFlagsCullBackFacingTrianglesEXT,
                 globalUniform.rayCullMaskWorld,
                 0, 0, // sbtRecordOffset, sbtRecordStride
                 SBT_INDEX_MISS_DEFAULT,
                 origin,
                 0.001,
                 -up,
                 globalUniform.waterCausticDist,
                 PAYLOAD_INDEX_DEFAULT );

    if( !doesPayloadContainHitInfo( g_payload ) )
    {
        return false;
    }

    int instanceId, instanceCustomIndex;
    unpackInstanceIdAndCustomIndex( g_payload.instIdAndIndex, instanceId, instanceCustomIndex );

    return ( geometryInstances[ instanceId ].flags & GEOM_INST_FLAG_MEDIA_TYPE_WATER ) != 0;
}

// Animated caustic field. Two wave fields scrolling against each other; the
// filaments are where they CONVERGE, which is what focuses light in real
// caustics -- hence the sharp power curve rather than a plain texture lookup.
float getWaterCaustic( const vec3 position )
{
    const vec3 up = globalUniform.worldUpVector.xyz;

    // project onto the horizontal plane: the pattern belongs to the water
    // surface, so on a vertical wall it correctly reads as upward streaks
    const vec3 flat3 = position - up * dot( position, up );
    const mat3 basis = getONB( up );
    const vec2 xy    = vec2( dot( flat3, basis[ 0 ] ), dot( flat3, basis[ 1 ] ) );

    // NOTE: world space here is METRES (gzdoom scales by ONEGAMEUNIT_IN_METERS
    // = 1/32), so the scale is UV per METRE. At 0.09 the field repeated every
    // ~11 m = ~350 map units -- a whole room inside one caustic cell, which
    // brightens and dims as a single flat wash instead of reading as caustics.
    const float s = globalUniform.waterCausticScale;
    const float t = globalUniform.time * globalUniform.waterCausticSpeed;

    vec2 uv0 = xy * s + vec2( t, t * 0.6 );
    vec2 uv1 = xy * s * 1.3 - vec2( t * 0.7, t );

    // getTextureSampleLod, NOT getTextureSample: a raygen shader has no
    // quad derivatives, so an implicit-LOD texture() fetch is undefined there.
    vec2 n0 = getTextureSampleLod( globalUniform.waterNormalTextureIndex, uv0, 0.0 ).xy * 2.0 - 1.0;
    vec2 n1 = getTextureSampleLod( globalUniform.waterNormalTextureIndex, uv1, 0.0 ).xy * 2.0 - 1.0;

    float converge = 1.0 - clamp( length( n0 + n1 ), 0.0, 1.0 );

    // sharp: caustics are thin bright filaments over a mostly dark field
    return pow( converge, 8.0 );
}

void main()
{
    const ivec2 pix = ivec2(gl_LaunchIDEXT.xy);
    const uint seed = getRandomSeed(pix, globalUniform.frameId);

    const Surface surf = fetchGbufferSurface(pix);

    if (surf.isSky)
    {
        imageStore(framebufUnfilteredDirect, pix, uvec4(0));
        imageStore(framebufUnfilteredSpecular, pix, uvec4(0));
        imageStore(framebufGradientInputs, pix, vec4(0.0));
        imageStoreReservoir(emptyReservoir(), pix);
        return;
    }

    vec3 diffuse, specular;
    float distToLight;
    Reservoir r = processDirectIllumination(
        seed,
        pix, 
        surf,
        distToLight,
        diffuse, specular);

    // Debug: show the reservoir's accumulated sample count instead of radiance.
    // ReSTIR at 1 spp only looks clean because temporal reuse grows M over many
    // frames; the estimator's variance falls with M. If M collapses when the
    // camera moves (history rejected by testSurfaceForReuse after
    // reprojection), the raw signal genuinely gets noisier in motion -- which no
    // denoiser tuning can fix, because it is upstream of every denoiser.
    // Green ramp = M/32: black is M=1 (worst case, one sample), bright green is
    // a well-accumulated reservoir. Watch it while standing still, then move.
    if (globalUniform.debugRestirM != 0)
    {
        float mNorm = clamp(float(r.M) / 32.0, 0.0, 1.0);
        imageStoreUnfilteredDirect(pix, vec3(mNorm * 0.15, mNorm, mNorm * 0.15));
        imageStoreUnfilteredSpecular(pix, vec3(0.0));
        imageStore(framebufViewDirection, pix, vec4(-surf.toViewerDir, distToLight));
        imageStore(framebufGradientInputs, pix, vec4(0.0));
        imageStoreReservoir(r, pix);
        return;
    }

    // Debug: show what the shadow ray actually returned.
    //
    // The final image cannot distinguish "the occluder never blocked the ray"
    // from "the shadow is cast but drowned in fill light or smeared away by the
    // denoiser" -- both look like no shadow. Visibility is the only thing a
    // shadow ray produces, so showing it directly answers that question and
    // nothing else.
    //
    // 1 = greyscale, black where shadowed. Reads as a pure shadow map.
    // 2 = normal shading with shadowed pixels tinted red, so an umbra can be
    //     located against the geometry that casts it.
    if (globalUniform.debugVisibility != 0)
    {
        const float vis = clamp(g_debugVisibility, 0.0, 1.0);

        if (globalUniform.debugVisibility == 1)
        {
            imageStoreUnfilteredDirect(pix, vec3(vis));
        }
        else
        {
            imageStoreUnfilteredDirect(pix, diffuse * mix(vec3(1.0, 0.15, 0.15), vec3(1.0), vis));
        }
        imageStoreUnfilteredSpecular(pix, vec3(0.0));
        imageStore(framebufViewDirection, pix, vec4(-surf.toViewerDir, distToLight));
        imageStore(framebufGradientInputs, pix, vec4(0.0));
        imageStoreReservoir(r, pix);
        return;
    }

    // Doom64-RT: water caustics on the surrounding geometry. Applied here, to
    // the noisy direct term, so it is upstream of BOTH denoisers and of the
    // DLSS-RR guides -- a post-denoise multiply would not be present in the
    // guides RR demodulates by, which is what makes such terms shimmer.
    if( globalUniform.waterCausticGain > 0.0 && isOverWater( surf.position, surf.normal ) )
    {
        const float caustic = getWaterCaustic( surf.position );
        diffuse *= 1.0 + globalUniform.waterCausticGain * caustic;
    }

    imageStoreUnfilteredDirect(pix, diffuse);
    imageStoreUnfilteredSpecular(pix, demodulateSpecular(specular, surf.specularColor));
    imageStore(framebufViewDirection, pix, vec4(-surf.toViewerDir, distToLight));
    imageStore(framebufGradientInputs, pix, vec4(getLuminance(diffuse), getLuminance(specular), 0, 0));
    imageStoreReservoir(r, pix);
}