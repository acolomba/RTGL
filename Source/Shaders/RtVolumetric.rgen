#version 460

#define MATERIAL_MAX_ALBEDO_LAYERS    0
#define MATERIAL_LIGHTMAP_LAYER_INDEX -1

#define DESC_SET_TLAS           0
#define DESC_SET_FRAMEBUFFERS   1
#define DESC_SET_GLOBAL_UNIFORM 2
#define DESC_SET_VERTEX_DATA    3
#define DESC_SET_TEXTURES       4
#define DESC_SET_RANDOM         5
#define DESC_SET_LIGHT_SOURCES  6
#define DESC_SET_CUBEMAPS       7
#define DESC_SET_RENDER_CUBEMAP 8
#define DESC_SET_VOLUMETRIC     11
#define LIGHT_SAMPLE_METHOD     ( LIGHT_SAMPLE_METHOD_VOLUME )
#include "RaygenCommon.h"
#include "Volumetric.h"
#include "Smoke.h"

// Doom64-RT: who wants the per-froxel all-lights estimate this frame.
//   illumVolumeEnable -- the RASTER path (RsWorld.inl, rt_illum_volume) reads
//                        g_illuminationVolume to shade translucent primitives.
//   volumeAllLights   -- the FOG (rt_fog_illum) wants to be lit by more than
//                        the single light TryGetVolumetricLight picked.
// Both WRITE the volume; only the first makes anything read it.
#if ILLUMINATION_VOLUME
    #define ILLUM_VOLUME_ACTIVE                                                                            ( globalUniform.illumVolumeEnable != 0 || globalUniform.volumeAllLights != 0 )
#else
    #define ILLUM_VOLUME_ACTIVE false
#endif

// Approximation of Henyey-Greenstein's phase function
float phaseFunction_Schlick( const vec3 tolight, const vec3 toviewer, float assymetry )
{
    float costheta = dot( tolight, toviewer );
    float k = 1.55 * assymetry - 0.55 * assymetry * assymetry * assymetry;

#if SHIPPING_HACK
    k = min( k, 1.0 );
#endif

    return ( 1 - square( k ) ) / ( 4 * M_PI * square( 1 + k * costheta ) );
}

vec3 traceDirectIllumination_SpecificLight( const vec3 from, inout vec3 out_lightdirection )
{
    if( globalUniform.volumeLightSourceIndex != LIGHT_INDEX_NONE )
    {
        LightSample light =
            sampleLight( lightSources[ globalUniform.volumeLightSourceIndex ], from, vec2( 0 ) );

        vec3 radiance = light.dw * light.color;

        if( getLuminance( radiance ) > 0.0 )
        {
            bool isShadowed = traceShadowRay( 0, from, light.position, true );

            out_lightdirection = safeNormalize2( from - light.position, vec3( 0 ) );

            // Doom64-RT: the sky-reach test, repeated HERE.
            //
            // This shader does not go through traceDirectIllumination -- it picks
            // one light (TryGetVolumetricLight) and shadow-tests it itself. The
            // visible shafts ARE volumetric scattering of exactly this light, so
            // the probe added to the shared path never touched them: no red, and
            // rt_sun_require_sky did nothing to them. This is the code that
            // actually lights them.
            if( !isShadowed &&
                globalUniform.volumeLightSourceIndex == LIGHT_ARRAY_DIRECTIONAL_LIGHT_OFFSET &&
                ( globalUniform.sunRequireSky > 0.5 || globalUniform.sunLeakDebug > 0.5 ) )
            {
                bool reachedSky = traceSunReachesSky(
                    from, safeNormalize2( light.position - from, vec3( 0, 0, 1 ) ) );

                // The fix runs FIRST, so the debug views show the result of it
                // rather than replacing it. With require_sky and colour mode both
                // on, every surviving shaft is red -- and an all-red screen is
                // exactly the confirmation that the fix worked. Making these two
                // mutually exclusive (the first attempt) meant the fix could
                // never be seen, only trusted.
                if( globalUniform.sunRequireSky > 0.5 && !reachedSky )
                {
                    return vec3( 0 );
                }

                // mode 1: isolate the leak -- drop everything legitimate
                if( globalUniform.sunLeakDebug > 0.5 && globalUniform.sunLeakDebug < 1.5 &&
                    reachedSky )
                {
                    return vec3( 0 );
                }

                // mode 2: colour whatever survived. RED reached sky, GREEN escaped
                // the map. Green rather than blue because these interiors are
                // near-black and blue reads as shadow in them.
                if( globalUniform.sunLeakDebug > 1.5 )
                {
                    return ( reachedSky ? vec3( 1.0, 0.02, 0.02 ) : vec3( 0.05, 1.0, 0.10 ) ) *
                           max( globalUniform.sunLeakDebugMul, 0.001 );
                }
            }

            return radiance * float( !isShadowed );
        }
    }
    else if( globalUniform.volumeFallbackSrcExists != 0 )
    {
        bool isShadowed = traceShadowRay(
            0, from, from - MAX_RAY_LENGTH * globalUniform.volumeFallbackSrcDirection.xyz, true );

        out_lightdirection = globalUniform.volumeFallbackSrcDirection.xyz;
        return globalUniform.volumeFallbackSrcColor.rgb * float( !isShadowed );
    }

    out_lightdirection = vec3( 0, -1, 0 );
    return vec3( 0 );
}

void main()
{
    const ivec3 cell = ivec3( gl_LaunchIDEXT.xyz );

    if( globalUniform.volumeEnableType != VOLUME_ENABLE_VOLUMETRIC )
    {
        imageStore( g_volumetric, cell, vec4( 0.0 ) );
#if ILLUMINATION_VOLUME
        if( ILLUM_VOLUME_ACTIVE )
        {
            imageStore( g_illuminationVolume, cell, vec4( 0.0 ) );
        }
#endif
        return;
    }

    vec3       center   = volume_getCenter( cell );
    const vec3 toviewer = normalize( globalUniform.cameraPosition.xyz - center );

    // Doom64-RT: the UNJITTERED cell centre, kept for the smoke density below.
    const vec3 centerStable = center;

    {
        vec3  s      = volume_getCenter( cell + ivec3( 0, 0, 1 ) );
        vec3  radius = ( center - s ) * 0.5;
        uint  seed   = getRandomSeed( cell.xy, globalUniform.frameId );
        float rnd    = rndBlueNoise8( seed, 0 ).x * 2 - 1;
        center += radius * rnd;
    }

    // Doom64-RT: the localised smoke at this froxel, evaluated BEFORE the
    // lighting block because both trap fixes below key off it. See Smoke.h;
    // vec4( 0 ) on every frame with no puffs, which is nearly all of them.
    //
    // Deliberately the UNJITTERED centre. The blue-noise jitter above moves the
    // sample by up to half a slice ALONG THE VIEW, which is fine for fog -- it
    // dithers the depth quantisation of a medium that barely changes between
    // slices. A puff is only one to three slices thick, so the same jitter
    // randomly puts a cell inside or outside it every frame, and that shows up
    // as boiling salt-and-pepper over the whole puff. Sampling density at the
    // stable centre trades that for honest depth banding, which the eye reads as
    // shape rather than as noise. The LIGHTING still uses the jittered position.
    const vec4  smoke   = smoke_evalAt( centerStable );
    const bool  inSmoke = smoke.a > 0.0;

    // TRAP 1, the near-light fade. RaygenCommon.h fades in-scattering out
    // within volumeLightNearFade metres OF A LIGHT, because a light carried at
    // the camera otherwise whites out the froxels in front of it (rt-fog.md
    // S4). A muzzle flash lighting the smoke at the barrel is the ENTIRE point
    // of the smoke, and at the fog's 2 m the puff is fully faded -- so smoke
    // cells take their own value.
    //
    // Chosen PER CELL, never per frame: a per-frame override would retune the
    // shipped fog every time the player pulled the trigger.
    g_volumeLightNearFade =
        inSmoke ? globalUniform.smokeLightNearFade : globalUniform.volumeLightNearFade;

    // Smoke only. A fog cell keeps receiving every light in the level.
    g_volumeLightFarFade = inSmoke ? globalUniform.smokeLightFarFade : 0.0;

    // TRAP 3, and the one that cost a playtest. volumeAllLights switches the
    // WHOLE volume off traceDirectIllumination_SpecificLight -- and that
    // function is the only place the sun's sky-probe test lives, i.e. the only
    // thing that makes a map's light shafts. Turning it on per FRAME because a
    // puff exists therefore deletes every shaft in the level for as long as the
    // player is shooting, which is exactly what it looked like.
    //
    // So smoke asks for the all-lights estimate per CELL. A froxel with no smoke
    // in it keeps the single-light path, shafts and all; a froxel inside a puff
    // gets the full estimate, which is what lets its own muzzle flash light it.
    const bool allLightsCell =
        ILLUM_VOLUME_ACTIVE || ( inSmoke && globalUniform.smokeAllLights != 0 );

    vec3 lighting = globalUniform.volumeAmbient.rgb;
    vec3 radiance = vec3( 0.0 );

#if ILLUMINATION_VOLUME
    // Doom64-RT: two separate reasons to run the all-lights estimate (see
    // ILLUM_VOLUME_ACTIVE above). They used to be ONE flag, so asking for lit
    // fog also changed how every sprite and particle in the game is shaded.
    // Both flags WRITE the volume -- the 0.05 temporal blend below reads back
    // what it stored last frame and would never converge without the store --
    // but only illumVolumeEnable makes RsWorld.inl read it.
    if( allLightsCell )
    {
        // REPROJECTED history. This used to be imageLoad( ..., cell ) -- the
        // same cell INDEX as last frame -- and the froxel grid is attached to
        // the camera, so cell (x,y,z) is a different piece of world the instant
        // you turn or walk. The history was simply wrong while moving, which is
        // why the blend had to stay high (little averaging, much noise) and why
        // moving with a flashlight was the worst case in the game.
        //
        // Now the cell's WORLD position is projected into the previous frame's
        // volume and sampled there. Reading the sampler rather than the storage
        // image matters: the sampler is bound to the PREVIOUS frame's image, so
        // this cannot read memory the current pass is still writing.
        vec3       radiance_Prev = vec3( 0 );
        const vec3 spPrev        = volume_toSamplePosition_T(
            centerStable, globalUniform.volumeViewProj_Prev, globalUniform.cameraPositionPrev.xyz );

        // Off-screen last frame, or behind the near plane: there is no history to
        // reuse. Taking the new estimate outright is right here -- clamping to
        // black instead would draw a dark halo along every disocclusion edge.
        const bool histValid = all( greaterThanEqual( spPrev, vec3( 0.0 ) ) ) &&
                               all( lessThanEqual( spPrev, vec3( 1.0 ) ) );

        if( histValid )
        {
            radiance_Prev = textureLod( g_illuminationVolume_Sampler, spPrev, 0.0 ).rgb;
        }

        if( any( isnan( radiance_Prev ) ) || any( isinf( radiance_Prev ) ) )
        {
            radiance_Prev = vec3( 0 );
        }

        uint seed =
            getRandomSeed( ivec2( cell.x + cell.z, cell.y + 19 * cell.z ), globalUniform.frameId );

        // TODO: processDirectIllumination without normals
        vec3 n = safeNormalize2( toviewer, vec3( 0, 1, 0 ) );

        Surface s;
        {
            s.position        = center;
            s.instCustomIndex = 0;
            s.roughness       = 1.0;
            s.normal          = n;
            s.albedo          = vec3( 1.0 );
            s.isSky           = false;
            s.specularColor   = vec3( 0.04 );
            s.toViewerDir     = toviewer;
        }

        vec3 tolight = vec3( 0, 1, 0 );

        // MULTIPLE SAMPLES, but only where there is smoke.
        //
        // Everything else added for the noise -- the spatial filter, the
        // reprojected history -- smooths an estimate made from ONE sample. This
        // is the only knob that improves the estimate itself. It is affordable
        // because a puff covers a few per cent of the grid: paying 4x in those
        // cells is a rounding error against 900k cells at 1x, where raising the
        // global rate would not be.
        //
        // Each sample needs its own seed or they all pick the same light and
        // average to exactly the one-sample answer. The first sample's direction
        // is kept for the phase function; averaging directions would bend the
        // scattering lobe toward nothing in particular.
        const uint sppN = inSmoke ? max( globalUniform.smokeSpp, 1u ) : 1u;

        vec3 estimate = vec3( 0.0 );
        for( uint si = 0; si < sppN; si++ )
        {
            uint sd = getRandomSeed( ivec2( cell.x + cell.z + int( si ) * 7,
                                            cell.y + 19 * cell.z + int( si ) * 13 ),
                                     globalUniform.frameId + si * 977 );

            vec3 tl_i = vec3( 0, 1, 0 );
            estimate += processDirectIllumination( sd, s, 0, tl_i ) * 4 * M_PI;

            if( si == 0 )
            {
                tolight = tl_i;
            }
        }

        radiance += estimate / float( sppN );
        // TRAP 2, the temporal blend. 0.05 is right for fog, which changes
        // only as fast as the player walks. A muzzle flash lasts 2-3 frames:
        // at 0.05 the volume needs ~0.7 s to respond and as long again to let
        // go, so the smoke would light up AFTER the flash and then linger.
        // Per cell for the same reason as trap 1 -- fog cells keep the 0.05.
        // With a valid reprojected history the blend can be much lower, which is
        // the entire point of the change: more frames of averaging for the same
        // responsiveness. Without one, take the new estimate whole.
        const float blend = !histValid ? 1.0
                            : inSmoke  ? globalUniform.smokeIllumBlend
                                       : 0.05;

        radiance = mix( radiance_Prev, radiance, blend );

        lighting += globalUniform.volumeLightMult * radiance *
                    phaseFunction_Schlick( tolight, toviewer, globalUniform.volumeAsymmetry );
    }
    else
#endif
    {
        vec3 lightdir;
        radiance += traceDirectIllumination_SpecificLight( center, lightdir );

        lighting += globalUniform.volumeLightMult * radiance *
                    phaseFunction_Schlick( -lightdir, toviewer, globalUniform.volumeAsymmetry );
    }


    // Doom64-RT: the medium, as a NEAR->FAR ramp.
    //
    // cell.z is a straight depth fraction -- volume_getCenter mixes near..far
    // linearly (VOLUMETRIC_DISTANCE_POW is 1) -- so "the air around you" and
    // "the far end of the corridor" are separable here for one mix() per cell,
    // with no extra rays and no second volume. That separation is what makes
    // fog tunable at all: one density cannot be both thin enough to see your
    // feet through and thick enough to swallow a corridor.
    //
    // The tint is applied to the WHOLE in-scattered term -- ambient and lit
    // alike -- so a cyan fog is cyan and so is the haze around a lamp standing
    // in it. Extinction is left monochrome: the transmittance channel is one
    // float all the way to CmPrepareFinal, so distance fades toward this colour
    // instead of filtering by it. { 1, 1, 1 } at both ends is the no-op, and
    // every map that asks for nothing gets it.
    const float depthfrac = float( cell.z ) / float( VOLUMETRIC_SIZE_Z - 1 );
    const float ramp      = pow( depthfrac, globalUniform.volumeDensityCurve );

    // Doom64-RT: the fog's medium and the smoke's, combined by density. With no
    // smoke this is the fog's two lines BIT for bit, not merely algebraically:
    // smoke_blendTint returns early and `fogDens + 0.0` is exactly fogDens. See
    // the collapse note in Smoke.h; tools/ab-smoke.cmd fogsafe is the check.
    const vec3  fogTint = mix( globalUniform.volumeMediaColor.rgb,
                               globalUniform.volumeMediaColorFar.rgb,
                               ramp );
    const float fogDens =
        mix( globalUniform.volumeScattering, globalUniform.volumeScatteringFar, ramp );

    // WHITEOUT GUARD, smoke only. A carried light at ~0 m -- the flashlight, the
    // plasma rifle's glow -- lights the froxels around it by inverse square, and
    // a dense puff sitting in front of the camera therefore saturates to white.
    // rt_fog_light_near exists for exactly that, and smoke turns it off on
    // purpose so a muzzle flash can light its own puff; this bounds the RESULT
    // instead, which keeps the flash while refusing to blow out the screen.
    // Fog is untouched: it has the fade.
    if( inSmoke && globalUniform.smokeMaxLight > 0.0 )
    {
        const float lum = getLuminance( lighting );
        if( lum > globalUniform.smokeMaxLight )
        {
            lighting *= globalUniform.smokeMaxLight / lum;
        }
    }

    // SMOKE'S SELF-VISIBILITY. Added before the tint multiply, so it picks up
    // the puff's own albedo and reads as grey powder rather than as a white
    // haze.
    //
    // Without this a puff is only ever as visible as whatever is lighting it,
    // and a muzzle flash lasts two or three frames against a trail that lasts
    // two seconds -- so the smoke appeared with the bang and then vanished,
    // which is not what smoke does. The volume's own ambientColor cannot serve:
    // it is one per-frame value for the whole grid, so raising it for smoke
    // would raise it for the fog on nine maps.
    //
    // Scaled by the puff's density so a thin rim does not glow as much as the
    // core -- a flat add makes the whole ellipsoid one slab of grey and throws
    // away the falloff the stylization just went to the trouble of banding.
    if( inSmoke && globalUniform.smokeAmbient > 0.0 )
    {
        lighting += vec3( globalUniform.smokeAmbient * min( smoke.a, 1.0 ) );
    }

    lighting *= smoke_blendTint( fogTint, fogDens, smoke );

    float scattering = ( fogDens + smoke.a ) * 0.001;
    float absorbtion = 0.0;

    // Doom64-RT: the shader-side probe. Deliberately AFTER the real medium, so
    // it overwrites rather than perturbs, and deliberately unmissable -- the
    // point is to answer one question with a glance.
    //
    //   2 -- magenta wherever a puff covers a froxel. If this paints nothing,
    //        the uniform is being read but no cell passes the sphere test, so
    //        the puff is somewhere other than where it is believed to be.
    //   3 -- green over the WHOLE screen whenever the list is non-empty, with no
    //        position test at all. If 3 is blank while the engine log says
    //        puffs were sent, the shader is not seeing the uniform.
    if( globalUniform.smokeDebug == 2 && inSmoke )
    {
        lighting   = vec3( 1.0, 0.0, 1.0 );
        scattering = 0.5;
    }
    else if( globalUniform.smokeDebug == 3 && globalUniform.smokeCount > 0 )
    {
        lighting   = vec3( 0.0, 1.0, 0.0 );
        scattering = 0.05;
    }
    else if( globalUniform.smokeDebug == 8 &&
             globalUniform
                     .smokeAlbedoDensity[ clamp( int( globalUniform.smokeIllumBlend * 100.0 ),
                                                 0,
                                                 SMOKE_PUFF_MAX - 1 ) ]
                     .a > 0.0 )
    {
        // WHITE if the LAST element of the first array reads non-zero. That
        // element sits at exactly 2048 bytes into the uniform -- the boundary
        // the swap experiment bracketed.
        lighting   = vec3( 1.0, 1.0, 1.0 );
        scattering = 0.05;
    }
    else if( globalUniform.smokeDebug == 7 && globalUniform.smokeAlbedoDensity[ 0 ].a > 0.0 )
    {
        // CYAN if the DENSITY of puff 0 reads non-zero. This is the only field
        // smoke_evalAt uses that the position probe does not -- and a zero here
        // makes smoke.a zero for every cell, which blanks probe 2 and the real
        // medium alike while every position test still passes.
        lighting   = vec3( 0.0, 1.0, 1.0 );
        scattering = 0.05;
    }
    else if( globalUniform.smokeDebug == 5 && globalUniform.smokePuffs[ 0 ].w > 0.0 )
    {
        // YELLOW if the RADIUS field of puff 0 reads non-zero. Tests the
        // smokePuffs array read itself, independently of any distance maths.
        lighting   = vec3( 1.0, 1.0, 0.0 );
        scattering = 0.05;
    }
    else if( globalUniform.smokeDebug == 6 &&
             length( center - globalUniform.smokePuffs[ 0 ].xyz ) <
                 max( 0.01, globalUniform.smokeLightNearFade ) )
    {
        // RED within 5 METRES of puff 0 -- the same test the medium does, with
        // the radius replaced by something far larger than any froxel spacing.
        // If this paints and mode 2 does not, the positions are right and the
        // radius is too small for the grid; if it does not paint either, the
        // position data itself is wrong in the shader.
        lighting   = vec3( 1.0, 0.0, 0.0 );
        scattering = 0.3;
    }
    else if( globalUniform.smokeDebug == 4 )
    {
        // Reads smokeDebug and NOTHING else -- no count, no positions. Blank
        // here means the shader cannot see this uniform group at all, or the
        // volumetric output is not reaching the screen; and those are the only
        // two hypotheses left once the library reports the values as correct.
        // 0.1 per cell over 64 cells is an optical depth of ~6: the screen goes
        // solid blue. Deliberately far past "visible" -- this probe exists to
        // answer yes or no, not to look like anything.
        lighting   = vec3( 0.0, 0.4, 1.0 );
        scattering = 0.1;
    }


    imageStore( g_volumetric, cell, vec4( lighting * scattering, scattering + absorbtion ) );

#if ILLUMINATION_VOLUME
    // Store whenever the estimate RAN, not whenever the frame flag is set: the
    // 0.05/smokeIllumBlend blend reads this back, so a cell that computes and
    // does not store would read a stale image forever and never converge. With
    // illumVolumeEnable on, every cell runs it and the image stays complete for
    // RsWorld.inl, which is the only thing that reads it.
    if( allLightsCell )
    {
        imageStore( g_illuminationVolume, cell, vec4( radiance, 0.0 ) );
    }
#endif
}
